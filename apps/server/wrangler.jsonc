// mcpy server. Generic config: anyone can deploy it as is. The "lytl"
// environment at the bottom is the maintainers' own deployment
// (tools.ly.tl) and doubles as an example of a custom-domain setup.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mcpy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Invocation logs record full request URLs, which would capture `?key=`
  // API keys; our own structured logs never include query strings.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  // Cache. Wrangler provisions the namespace on first deploy when no id is set.
  "kv_namespaces": [{ "binding": "CACHE" }],
  // One data point per operation and provider attempt (SQL-queryable metrics).
  "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "mcpy" }],
  // Per-client rate limit (keyed by client name).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    // Failed authentications per client IP.
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // BUDGET: today's spend per client, one object per client name (DAILY_BUDGET_USD).
  // USAGE: one object holding every client's call log (the usage tools).
  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "ClientBudget" },
      { "name": "USAGE", "class_name": "UsageLog" }
    ]
  },
  "migrations": [
    { "tag": "v1-budget", "new_sqlite_classes": ["ClientBudget"] },
    { "tag": "v2-usage", "new_sqlite_classes": ["UsageLog"] }
  ],
  // Runs fetch scripts (Workers cannot eval a string). Workers Paid plan.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Browser Rendering for JavaScript pages (the cloudflare_browser provider), no API token.
  "browser": { "binding": "BROWSER" },

  // Non-secret settings; secrets (MCPY_CLIENTS, provider keys, OTLP headers)
  // go through `wrangler secret put`. See README for every option.
  "vars": {
    "PAGE_PROVIDERS": "direct,cloudflare_browser,firecrawl,brightdata",
    "SEARCH_PROVIDERS": "serpent,firecrawl,brightdata",
    "PAPER_PROVIDERS": "openalex,arxiv,pubmed,semantic_scholar",
    "LISTING_PROVIDERS": "serpent",
    // Estimated USD each client may spend on paid sources per UTC day.
    "DAILY_BUDGET_USD": "5",
    "LOG_LEVEL": "info",
    "DEPLOYMENT_ENV": "production"
  },

  "env": {
    // npm run deploy -- --env lytl
    "lytl": {
      "name": "mcpy-lytl",
      "routes": [{ "pattern": "tools.ly.tl", "custom_domain": true }],
      // Served on tools.ly.tl only: no *.workers.dev or preview address beside it.
      "workers_dev": false,
      "preview_urls": false,
      "kv_namespaces": [{ "binding": "CACHE" }],
      "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "mcpy_lytl" }],
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "BUDGET", "class_name": "ClientBudget" },
          { "name": "USAGE", "class_name": "UsageLog" }
        ]
      },
      "worker_loaders": [{ "binding": "LOADER" }],
      "browser": { "binding": "BROWSER" },
      "vars": {
        "ALLOWED_HOSTNAMES": "tools.ly.tl",
        "PAGE_PROVIDERS": "direct,cloudflare_browser,firecrawl,brightdata",
        "SEARCH_PROVIDERS": "serpent,firecrawl,brightdata",
        "PAPER_PROVIDERS": "openalex,arxiv,pubmed,semantic_scholar",
        "LISTING_PROVIDERS": "serpent",
        "DAILY_BUDGET_USD": "1",
        // cardy drained the Firecrawl plan in early Nov 2026; keep it well under the Hobby plan.
        // Raised to $0.40 on 2026-11-23: card marketplace product pages are paid rendered fetches.
        // Set to $1 on 2026-11-24, once MTGStocks, Fanatics Collect and PriceCharting fetched direct for free.
        // deepmine is our own mining operation; its daily pricing runs cost well under $0.50 (Nov 2026).
        // Raised to $1 on 2026-11-25 (owner): its normal day is about $0.24 (wemine's daily product pages),
        // and $0.50 left no room once Kryptex's refused chart reads were paid for (fixed the same day).
        "CLIENT_DAILY_BUDGETS_USD": "cardy:1,deepmine:1",
        // Answers are kept a day; each call says how old a copy it accepts (max_age).
        "PAGE_CACHE_TTL_SECONDS": "86400",
        "SEARCH_CACHE_TTL_SECONDS": "86400",
        "LOG_LEVEL": "info",
        "DEPLOYMENT_ENV": "lytl"
      }
    }
  }
}
