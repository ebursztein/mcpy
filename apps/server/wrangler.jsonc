// mcpy server. Generic config: anyone can deploy it as is. The "lytl"
// environment at the bottom is the maintainers' own deployment
// (tools.ly.tl) and doubles as an example of a custom-domain setup.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mcpy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Invocation logs record full request URLs, which would capture `?key=`
  // API keys; our own structured logs never include query strings.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  // Cache. Wrangler provisions the namespace on first deploy when no id is set.
  "kv_namespaces": [{ "binding": "CACHE" }],
  // One data point per operation and provider attempt (SQL-queryable metrics).
  "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "mcpy" }],
  // Per-client rate limit (keyed by client name).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    // Failed authentications per client IP.
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 20, "period": 60 } }
  ],
  // Today's spend per client, one object per client name (DAILY_BUDGET_USD).
  "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "ClientBudget" }] },
  "migrations": [{ "tag": "v1-budget", "new_sqlite_classes": ["ClientBudget"] }],

  // Non-secret settings; secrets (MCPY_CLIENTS, provider keys, OTLP headers)
  // go through `wrangler secret put`. See README for every option.
  "vars": {
    "PAGE_PROVIDERS": "direct,cloudflare_browser,firecrawl,brightdata",
    "SEARCH_PROVIDERS": "firecrawl,brightdata",
    "PAPER_PROVIDERS": "openalex,arxiv,pubmed,semantic_scholar",
    // Estimated USD each client may spend on paid sources per UTC day.
    "DAILY_BUDGET_USD": "5",
    "LOG_LEVEL": "info",
    "DEPLOYMENT_ENV": "production"
  },

  "env": {
    // npm run deploy -- --env lytl
    "lytl": {
      "name": "mcpy-lytl",
      "routes": [{ "pattern": "tools.ly.tl", "custom_domain": true }],
      "kv_namespaces": [{ "binding": "CACHE" }],
      "analytics_engine_datasets": [{ "binding": "TELEMETRY", "dataset": "mcpy_lytl" }],
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
      ],
      "durable_objects": { "bindings": [{ "name": "BUDGET", "class_name": "ClientBudget" }] },
      "vars": {
        "ALLOWED_HOSTNAMES": "tools.ly.tl",
        "PAGE_PROVIDERS": "direct,cloudflare_browser,firecrawl,brightdata",
        "SEARCH_PROVIDERS": "firecrawl,brightdata",
        "PAPER_PROVIDERS": "openalex,arxiv,pubmed,semantic_scholar",
        "DAILY_BUDGET_USD": "1",
        // cardy drained the Firecrawl plan in early Nov 2026; keep it well under the Hobby plan.
        // deepmine is our own mining operation: generous, but still capped.
        "CLIENT_DAILY_BUDGETS_USD": "cardy:0.1,deepmine:3",
        "LOG_LEVEL": "info",
        "DEPLOYMENT_ENV": "lytl"
      }
    }
  }
}
